# Copy this file to .env and replace these placeholders with your own development
# PostgreSQL credentials. Never commit .env or use the production database for tests.
# URL-encode special characters in the username/password.

# Application connection. This example assumes your own local PostgreSQL database.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/certi_dev?schema=public"

# Schema-management connection. For local PostgreSQL, use the same URL.
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/certi_dev?schema=public"

# Supabase alternative: copy the actual host and username from your project's
# Connect dialog. DATABASE_URL may use the transaction pooler (port 6543) with
# ?pgbouncer=true appended. DIRECT_URL uses a direct connection or session pooler
# (port 5432), not the transaction pooler. Preserve required SSL parameters.
# These are server-only values: never add a NEXT_PUBLIC_ prefix.
