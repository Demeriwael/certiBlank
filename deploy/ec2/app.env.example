# Copy to /etc/certiblank/app.env on EC2 only. Owner root, permissions 600.
# Use real production values here, never in a GitHub Actions build.
# Compose reads this in raw format: no wrapping quotes, interpolation or escapes.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require
BETTER_AUTH_URL=https://certiblank.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_YOUR_EXISTING_PRODUCTION_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
